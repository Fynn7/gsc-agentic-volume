{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Volume Agent 端到端流程：从提交 Prompt 到运行完成",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "output": "docs/agent-prompt-to-completion.html"
  },
  "lanes": [
    {
      "id": "ui",
      "label": "Volume TUI 控制台"
    },
    {
      "id": "launch",
      "label": "启动器 run_local_agent.py（编排 + 无损记录）"
    },
    {
      "id": "render",
      "label": "渲染服务 + 原生 Raycaster"
    },
    {
      "id": "agent",
      "label": "智能体侧（Codex CLI + 本地 Ollama + renderer MCP）"
    }
  ],
  "phases": [
    {
      "id": "prep",
      "label": "准备与预检",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "start",
      "label": "启动与初始化",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "loop",
      "label": "观察循环与收尾",
      "fromCol": 4,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "nodes": [
    {
      "id": "prompt",
      "lane": "ui",
      "col": 0,
      "type": "external",
      "label": "用户提交 Prompt",
      "sublabel": "预设 A/B 或自定义任务",
      "width": 132
    },
    {
      "id": "preflight",
      "lane": "ui",
      "col": 1,
      "type": "backend",
      "label": "预检服务与模型",
      "sublabel": "Ollama · 渲染 · 上下文",
      "width": 132
    },
    {
      "id": "blocked",
      "lane": "ui",
      "col": 2,
      "type": "security",
      "label": "阻断启动",
      "sublabel": "不写配置，不建目录",
      "width": 132
    },
    {
      "id": "live",
      "lane": "ui",
      "col": 5,
      "type": "frontend",
      "label": "对话与证据校验",
      "sublabel": "实时跟随 · 证据校验",
      "width": 132
    },
    {
      "id": "reserve",
      "lane": "launch",
      "col": 2,
      "type": "backend",
      "label": "prepare_run 预留",
      "sublabel": "配置校验 + 任务锁 + 建目录",
      "width": 132
    },
    {
      "id": "fail",
      "lane": "launch",
      "col": 3,
      "type": "security",
      "label": "失败 / 超时 / 停止",
      "sublabel": "harness 被终止，证据保留",
      "width": 132
    },
    {
      "id": "report",
      "lane": "launch",
      "col": 5,
      "type": "database",
      "label": "归档与证据落盘",
      "sublabel": "final/ · run.json",
      "width": 132,
      "tag": "manifest.json"
    },
    {
      "id": "session",
      "lane": "render",
      "col": 2,
      "type": "backend",
      "label": "打开会话并初始渲染",
      "sublabel": "导入体数据 → frame-0",
      "width": 132,
      "tag": "/api/tools/open"
    },
    {
      "id": "render",
      "lane": "render",
      "col": 4,
      "type": "backend",
      "label": "执行工具并原生渲染",
      "sublabel": "参数校验 + revision+1",
      "width": 132
    },
    {
      "id": "boot",
      "lane": "agent",
      "col": 3,
      "type": "backend",
      "label": "拉起 Codex exec",
      "sublabel": "任务提示 + 注册 MCP",
      "width": 132
    },
    {
      "id": "decide",
      "lane": "agent",
      "col": 4,
      "type": "messagebus",
      "label": "模型决策并调用工具",
      "sublabel": "推理 → tools/call",
      "width": 132
    },
    {
      "id": "observe",
      "lane": "agent",
      "col": 5,
      "type": "backend",
      "label": "真实 PNG 回灌模型",
      "sublabel": "sha256 校验后回传",
      "width": 132
    }
  ],
  "edges": [
    {
      "id": "e-prompt-preflight",
      "from": "prompt",
      "to": "preflight",
      "role": "main"
    },
    {
      "id": "e-preflight-blocked",
      "from": "preflight",
      "to": "blocked",
      "label": "不满足即阻断",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "e-preflight-reserve",
      "from": "preflight",
      "to": "reserve",
      "label": "写配置并启动",
      "role": "main"
    },
    {
      "id": "e-reserve-session",
      "from": "reserve",
      "to": "session",
      "role": "main",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "e-session-boot",
      "from": "session",
      "to": "boot",
      "label": "启动 Codex",
      "role": "main"
    },
    {
      "id": "e-boot-decide",
      "from": "boot",
      "to": "decide",
      "label": "首轮请求",
      "role": "main"
    },
    {
      "id": "e-decide-render",
      "from": "decide",
      "to": "render",
      "label": "tools/call",
      "role": "main"
    },
    {
      "id": "e-render-observe",
      "from": "render",
      "to": "observe",
      "label": "新 PNG + sha256",
      "role": "main"
    },
    {
      "id": "e-observe-decide",
      "from": "observe",
      "to": "decide",
      "label": "真实 PNG 入模",
      "variant": "dashed",
      "role": "return"
    },
    {
      "id": "e-render-final",
      "from": "render",
      "to": "report",
      "label": "finish_task",
      "role": "branch"
    },
    {
      "id": "e-report-live",
      "from": "report",
      "to": "live",
      "label": "run.json 更新",
      "role": "main"
    },
    {
      "id": "e-boot-fail",
      "from": "boot",
      "to": "fail",
      "label": "超时或停止",
      "variant": "security",
      "role": "error"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "证据产物",
      "items": [
        "运行目录：run.json · config.json · manifest.json · harness.jsonl · telemetry.jsonl",
        "会话目录 runtime/<sessionId>：events.jsonl · frame-N/ · final/",
        "每次模型请求与响应无损落盘为 http-*.bin，可逐帧核对像素来源"
      ]
    },
    {
      "dot": "rose",
      "title": "停止与边界",
      "items": [
        "协作停止写 runtime/tui-control/<runId>.stop（退出码 130），超时退出码 124",
        "退出 TUI：协作停止 → 硬杀 agent 树 → 停自启 Ollama → 释放自有服务",
        "全程仅回环地址；模型与语义正确性始终标记 unverified"
      ]
    }
  ],
  "semanticChecks": {
    "allowedRoots": [
      "prompt"
    ],
    "allowedTerminals": [
      "blocked",
      "fail",
      "live"
    ]
  }
}