{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-with-backend.mjs",
    "dev:vite": "vite",
    "dev:backend": "node scripts/dev-with-backend.mjs --backend-only",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "fynns-ui:sync": "node scripts/fynns-ui-bootstrap.mjs",
    "fynns-ui:prepare": "node scripts/fynns-ui-bootstrap.mjs --prepare",
    "fynns-ui:check-exports": "node node_modules/@fynn7/ui-design-core/scripts/check-ui-exports.mjs --target .",
    "fynns-ui:gate": "npm run fynns-ui:sync && npm run fynns-ui:check-exports",
    "fynns-ui:check-update": "node node_modules/@fynn7/ui-design-core/scripts/check-ui-update.mjs || exit 0",
    "predev": "npm run fynns-ui:prepare && npm run fynns-ui:gate && npm run fynns-ui:check-update",
    "prebuild": "npm run fynns-ui:prepare && npm run fynns-ui:gate && npm run fynns-ui:check-update",
    "prepreview": "npm run fynns-ui:prepare && npm run fynns-ui:gate && npm run fynns-ui:check-update",
    "postinstall": "npm run fynns-ui:prepare && npm run fynns-ui:gate"
  },
  "dependencies": {
    "@fynn7/ui-design-core": "file:../../fynns_ui_design_core",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "oxlint": "^1.81.0",
    "typescript": "~5.7.3",
    "vite": "^6.4.4"
  }
}
